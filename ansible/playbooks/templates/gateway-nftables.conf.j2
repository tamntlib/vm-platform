# Managed by vm-platform — Debian gateway routing, DNS and bounded NAT.
add table inet vmp_gw
flush table inet vmp_gw

table inet vmp_gw {
  set dns_internal {
    type ipv4_addr;
  }
  set dns_isolated {
    type ipv4_addr;
  }
  set egress_internal {
    type ipv4_addr;
  }
  set egress_isolated {
    type ipv4_addr;
  }
  set lan_ssh_targets {
    type ipv4_addr;
  }

  chain input {
    type filter hook input priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept
    iifname "{{ gw_lan_iface }}" ip saddr {{ vmp_lan_cidr }} ip daddr {{ vmp_gateway.lan_ip }} tcp dport 22 accept
    iifname "{{ gw_int_iface }}" ip saddr @dns_internal ip daddr {{ vmp_networks.internal.gateway }} udp dport 53 accept
    iifname "{{ gw_int_iface }}" ip saddr @dns_internal ip daddr {{ vmp_networks.internal.gateway }} tcp dport 53 accept
    iifname "{{ gw_iso_iface }}" ip saddr @dns_isolated ip daddr {{ vmp_networks.isolated.gateway }} udp dport 53 accept
    iifname "{{ gw_iso_iface }}" ip saddr @dns_isolated ip daddr {{ vmp_networks.isolated.gateway }} tcp dport 53 accept
  }

  chain output {
    type filter hook output priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    oifname "lo" accept
    oifname "{{ gw_lan_iface }}" ip saddr {{ vmp_gateway.lan_ip }} ip daddr { {{ vmp_dns_upstreams | join(', ') }} } udp dport 53 accept
    oifname "{{ gw_lan_iface }}" ip saddr {{ vmp_gateway.lan_ip }} ip daddr { {{ vmp_dns_upstreams | join(', ') }} } tcp dport 53 accept
    oifname "{{ gw_int_iface }}" ip saddr {{ vmp_networks.internal.gateway }} ip daddr {{ vmp_bastion.internal_ip }} tcp dport 22 accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    iifname "{{ gw_lan_iface }}" oifname "{{ gw_int_iface }}" ip saddr {{ vmp_lan_cidr }} ip daddr {{ vmp_bastion.internal_ip }} tcp dport {{ vmp_bastion.recipient_port }} ct status dnat accept
    iifname "{{ gw_int_iface }}" oifname "{{ gw_lan_iface }}" ip saddr {{ vmp_bastion.internal_ip }} ip daddr @lan_ssh_targets tcp dport 22 accept
    iifname "{{ gw_int_iface }}" oifname "{{ gw_lan_iface }}" ip saddr @egress_internal ip daddr != { {{ vmp_non_internet_cidrs | join(', ') }} } accept
    iifname "{{ gw_iso_iface }}" oifname "{{ gw_lan_iface }}" ip saddr @egress_isolated ip daddr != { {{ vmp_non_internet_cidrs | join(', ') }} } accept
  }

  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "{{ gw_lan_iface }}" ip saddr {{ vmp_lan_cidr }} ip daddr {{ vmp_gateway.bastion_alias_ip }} tcp dport 22 dnat ip to {{ vmp_bastion.internal_ip }}:{{ vmp_bastion.recipient_port }}
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    iifname "{{ gw_lan_iface }}" oifname "{{ gw_int_iface }}" ip daddr {{ vmp_bastion.internal_ip }} tcp dport {{ vmp_bastion.recipient_port }} ct status dnat snat ip to {{ vmp_networks.internal.gateway }}
    iifname "{{ gw_int_iface }}" oifname "{{ gw_lan_iface }}" ip saddr {{ vmp_bastion.internal_ip }} ip daddr @lan_ssh_targets tcp dport 22 snat ip to {{ vmp_gateway.bastion_alias_ip }}
    iifname "{{ gw_int_iface }}" oifname "{{ gw_lan_iface }}" ip saddr @egress_internal snat ip to {{ vmp_gateway.lan_ip }}
    iifname "{{ gw_iso_iface }}" oifname "{{ gw_lan_iface }}" ip saddr @egress_isolated snat ip to {{ vmp_gateway.lan_ip }}
  }
}

include "/etc/vm-platform-gateway/clients.d/*.nft"
