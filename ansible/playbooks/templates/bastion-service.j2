[Unit]
Description=vm-platform forwarding-only SSH bastion
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/vm-platform-bastion/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/vm-platform-bastion/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure

[Install]
WantedBy=multi-user.target
